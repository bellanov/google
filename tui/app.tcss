
Screen {
    padding-left: 2;
    padding-right: 2;
    padding-top: 2;
}

Tabs {
    content-align: left top;
}

Footer {
    dock: bottom;
}

.text-primary {
    color: $text-primary;
}

.text-secondary {
    color: $text-secondary;
}

.text-accent {
    color: $text-accent;
}

.text-warning {
    color: $text-warning;
}

.text-error {
    color: $text-error;
}

.text-success {
    color: $text-success;
}

.foreground {
    color: $foreground;
}

.background {
    color: $background;
}

.surface {
    color: $surface;
}

.panel {
    color: $panel;
}

#header-container {
    dock: top;
    width: 100%;
    height: 8;
    position: absolute;
}

#google-header {
    text-style: bold;
    content-align: left top;
    margin-bottom: 2;
}

.header-label {
    width: 5;
    text-align: right;
    margin-right: 2;
}
